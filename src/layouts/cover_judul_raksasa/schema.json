{
  "slots": {
    "title":    {"type": "text", "required": true,  "min_chars": 8, "max_chars": 48, "min_font_px": 72, "emphasis": true},
    "kicker":   {"type": "text", "required": false, "max_chars": 32, "min_font_px": 28},
    "subtitle": {"type": "text", "required": false, "max_chars": 100, "min_font_px": 30, "emphasis": true}
  },
  "params": {
    "pos":   {"enum": ["bottom", "middle", "top"], "default": "bottom"},
    "ghost": {"enum": ["first", "last", "none"], "default": "first"},
    "lines": {"enum": ["2", "3", "4"], "default": "3"}
  }
}
