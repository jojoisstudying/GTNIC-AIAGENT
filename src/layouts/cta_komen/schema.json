{
  "slots": {
    "title":     {"type": "text", "required": true, "min_chars": 8, "max_chars": 48, "min_font_px": 72, "emphasis": true},
    "keyword":   {"type": "text", "required": true, "min_chars": 2, "max_chars": 12, "min_font_px": 64},
    "verb":      {"type": "text", "required": false, "max_chars": 12, "min_font_px": 30},
    "subtitle":  {"type": "text", "required": false, "max_chars": 90, "min_font_px": 30, "emphasis": true},
    "secondary": {"type": "text", "required": false, "max_chars": 44, "min_font_px": 30}
  },
  "params": {
    "lines": {"enum": ["3", "2"], "default": "3"},
    "bubble_side": {"enum": ["left", "right"], "default": "left"}
  }
}
