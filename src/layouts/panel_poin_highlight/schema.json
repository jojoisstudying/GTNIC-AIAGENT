{
  "slots": {
    "title": {
      "type": "text",
      "required": true,
      "min_chars": 8,
      "max_chars": 48,
      "min_font_px": 60,
      "emphasis": true
    },
    "points": {
      "type": "list",
      "required": true,
      "min_items": 3,
      "max_items": 5,
      "item_max_chars": 60,
      "min_font_px": 30,
      "emphasis": true
    },
    "kicker": {
      "type": "text",
      "required": false,
      "max_chars": 24,
      "min_font_px": 28
    }
  },
  "params": {
    "featured": {
      "enum": [
        "first",
        "none"
      ],
      "default": "first"
    }
  }
}
