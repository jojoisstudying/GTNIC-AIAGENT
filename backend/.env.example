# --- LLM & riset (wajib untuk generate konten) ---
# Pipeline memakai Groq untuk menulis rencana slide dan Tavily untuk riset web.
# Tanpa kunci ini run akan langsung berstatus failed: "No API keys configured for provider 'groq'".
GROQ_API_KEY=
TAVILY_API_KEY=
# Dukungan banyak kunci sekaligus (dipisah koma) juga tersedia lewat GROQ_API_KEYS / TAVILY_API_KEYS.
# Model utama & cadangan (ganti bila kuota/limit berubah)
GROQ_MODEL=openai/gpt-oss-120b
FALLBACK_MODEL=openai/gpt-oss-20b

# --- Anggaran token LLM (TPM) ---
# Isi sesuai batas akun di console.groq.com (free tier gpt-oss-120b = 8000 TPM).
# Kosongkan/0 = tanpa pengaturan otomatis; error 413 tetap ditangani dan dilaporkan.
LLM_TPM_LIMIT=8000
# Batas berbeda per model: model=limit,model=limit
LLM_TPM_LIMITS=
# Porsi batas TPM yang boleh dipakai (0.1-1.0). Default 0.92.
LLM_TPM_SAFETY_RATIO=0.92
# Batas token output per request. Turunkan bila masih kena 413.
LLM_MAX_COMPLETION_TOKENS=2048
# Estimasi karakter per token untuk Indonesia (default 2.8; lebih kecil = lebih konservatif)
LLM_CHARS_PER_TOKEN=2.8
# Detik maksimum menunggu sebelum request dikirim agar kuota menit cukup
LLM_TPM_MAX_WAIT=20
# 1 = satu limiter TPM dipakai bersama semua run dalam proses (disarankan; batas TPM
# dihitung per akun, bukan per run). 0 = limiter per run (hanya untuk debugging).
LLM_TPM_SHARE_LIMITER=1
# max token output khusus planner carousel (JSON 5-6 slide butuh ±3k).
# Otomatis diturunkan bila LLM_TPM_LIMIT kecil supaya prompt + output tetap muat.
LLM_PLANNER_MAX_TOKENS=3072
# gpt-oss: "low" = token reasoning lebih sedikit (hemat output), "" = default provider
LLM_REASONING_EFFORT=low
# Pemangkasan nilai riset/brand di prompt planner (karakter)
LLM_RESEARCH_VALUE_CHARS=400
LLM_BRAND_VALUE_CHARS=300

# Cloudflare Workers AI image editing (keep actual values in ignored .env)
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_workers_ai_token
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-9b
CLOUDFLARE_POSE_PERSON_ID=operator_01
# false = explicit generation only; true = Designer stages missing poses for human review
CLOUDFLARE_POSE_GENERATION=false

# --- Server & operasional ---
# Wajib di production. Frontend mengirim lewat header X-API-Key.
GTNIC_API_KEY=ganti_dengan_kunci_rahasia
# Pisahkan dengan koma; wildcard '*' ditolak.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# development | production
APP_ENV=development
# Hanya untuk development lokal tanpa API key
ALLOW_UNAUTHENTICATED_DEV=false
# Buat tabel otomatis saat startup (set false jika memakai alembic penuh)
AUTO_CREATE_SCHEMA=true
# Scheduler publikasi otomatis untuk item kalender berstatus 'scheduled'
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=60
# Seed analytics demo (simulated). Default: aktif di luar production
ALLOW_DEMO_SEED=
ANALYTICS_INGEST_INTERVAL_SECONDS=21600
LOG_LEVEL=INFO
# Autonomi diatur lewat Enterprise Profile -> approval_workflow:
#   {"autonomy_mode": "assisted|supervised|autonomous_routine|restricted",
#    "routine_categories": ["Tips Praktis"], "restricted_categories": ["Pengumuman Resmi"]}

# --- Instagram publishing (wajib untuk posting nyata) ---
IG_USER_ID=
IG_TOKEN=
# IG_API_BASE=https://graph.instagram.com
# --- Cloudinary (URL publik untuk media yang dikirim ke Meta) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# --- B-roll Reels, notifikasi, renderer ---
PEXELS_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
RENDERER=html
REMBG_PYTHON=
# --- Autopilot (jalan bila SCHEDULER_ENABLED=true) ---
AUTOPILOT_ENABLED=true
# Produksi otomatis item 'approved' yang jadwalnya dalam N jam ke depan
AUTOPILOT_LEAD_HOURS=48
# Maks. pipeline produksi paralel oleh autopilot (naikkan hanya bila limit Groq/CPU longgar)
AUTOPILOT_MAX_CONCURRENT=1
# Run 'running' lebih lama dari N menit dianggap macet dan ditandai gagal
AUTOPILOT_STALE_MINUTES=45
