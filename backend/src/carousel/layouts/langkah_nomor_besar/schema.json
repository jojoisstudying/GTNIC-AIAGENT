{
  "slots": {
    "number": {
      "type": "text",
      "required": false,
      "max_chars": 2,
      "min_font_px": 120
    },
    "title": {
      "type": "text",
      "required": true,
      "min_chars": 8,
      "max_chars": 44,
      "min_font_px": 64,
      "emphasis": true
    },
    "body": {
      "type": "text",
      "required": true,
      "min_chars": 20,
      "max_chars": 170,
      "min_font_px": 30,
      "emphasis": true
    },
    "kicker": {
      "type": "text",
      "required": false,
      "max_chars": 24,
      "min_font_px": 28
    }
  },
  "params": {
    "numeral": {
      "enum": [
        "fill",
        "outline"
      ],
      "default": "fill"
    }
  }
}
